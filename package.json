{
  "name": "@milehimikey/em-tracker-bridge",
  "version": "0.1.0",
  "description": "Deterministic em-slice -> issue-tracker bridge: mirrors em slice lifecycle transitions (draft/reviewed/ready-to-implement/implemented) into an issue tracker's own workflow states, one-way, never writing back to the model.",
  "type": "module",
  "bin": {
    "em-tracker-bridge": "dist/bridge.js"
  },
  "main": "./dist/bridge.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bridge": "tsx src/bridge.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "milehimikey",
  "homepage": "https://github.com/milehimikey/em-tracker-bridge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/milehimikey/em-tracker-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/milehimikey/em-tracker-bridge/issues"
  },
  "keywords": [
    "event-modeling",
    "em",
    "linear",
    "issue-tracker",
    "cli",
    "bridge"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  }
}
